# ─────────────────────────────────────────────────────────────
# PostPilot — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings (Project Settings → Database)
# DATABASE_URL uses the pooled connection (port 6543), DIRECT_URL the direct one (5432).
DATABASE_URL=
DIRECT_URL=

# Crypto — 64 hex chars (32 bytes). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Cron — shared secret for POST /api/cron/publish. Generate: openssl rand -hex 32
CRON_SECRET=

# AI — provider abstraction. AI_PROVIDER: "anthropic" (default) | "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Social platform OAuth apps (all OPTIONAL).
# When a platform's CLIENT_ID/SECRET are absent, PostPilot connects
# that platform in SANDBOX mode (simulated publishing, clearly labelled).
# ─────────────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
